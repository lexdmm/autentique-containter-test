SIMULATE_TIMEOUT=false
PUBLIC_BASE_URL=http://localhost:4100
# Match your host user so files written to the Downloads bind mount aren't owned by root.
# Run `id -u` / `id -g` to find your own values.
HOST_UID=1000
HOST_GID=1000
# Must match px-torre-core's AUTENTIQUE_WEBHOOK_SECRET exactly.
WEBHOOK_SECRET=local-mock-secret
# px-torre-core's webhook endpoint. On Linux, host.docker.internal needs the
# extra_hosts entry already in docker-compose.yml; on the Sail network this
# will instead be the app container's service name (finalized when wiring
# the two projects together).
PX_TORRE_CORE_WEBHOOK_URL=http://host.docker.internal:8000/api/webhooks/documents/signature
