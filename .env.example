SIMULATE_TIMEOUT=false
AUTENTIQUE_API_TOKEN=fake-local-token
PUBLIC_BASE_URL=http://localhost:4100
# Match your host user so files written to the Downloads bind mount aren't owned by root.
# Run `id -u` / `id -g` to find your own values.
HOST_UID=1000
HOST_GID=1000
# Must match the shared secret your application checks the webhook signature against.
WEBHOOK_SECRET=local-mock-secret
# Your application's webhook endpoint. This mock has no dependency on how your
# app is set up - point this at wherever that endpoint is reachable from this
# container. The default assumes your app exposes itself on host port 8080;
# adjust the port and path to your own setup.
WEBHOOK_TARGET_URL=http://host.docker.internal:8080/api/webhooks/autentique
