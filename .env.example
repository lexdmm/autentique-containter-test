SIMULATE_TIMEOUT=false
PUBLIC_BASE_URL=http://localhost:4100
# Match your host user so files written to the Downloads bind mount aren't owned by root.
# Run `id -u` / `id -g` to find your own values.
HOST_UID=1000
HOST_GID=1000
# Must match px-torre-core's AUTENTIQUE_WEBHOOK_SECRET exactly.
WEBHOOK_SECRET=local-mock-secret
# px-torre-core's webhook endpoint. This mock has no dependency on px-torre-core's
# own Docker setup - point this at wherever it's reachable from this container.
# The default assumes px-torre-core exposes its app on host port 8080 (Sail's
# default); adjust the port to whatever your own setup uses.
PX_TORRE_CORE_WEBHOOK_URL=http://host.docker.internal:8080/api/webhooks/documents/signature
